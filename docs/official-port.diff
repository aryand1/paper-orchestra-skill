+@contextlib.contextmanager
+def scope(name: str):
+    """Names a branch of the pipeline so call ids stay stable on replay."""
+    _CTX["stack"].append(str(name).replace("/", "_").replace(" ", "_"))
+    try:
+        yield
+    finally:
+        _CTX["stack"].pop()
