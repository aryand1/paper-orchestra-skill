+    existing_hash = None
+    if os.path.exists(prompt_path):
+        with open(prompt_path, "r", encoding="utf-8") as fh:
+            m = re.search(r"prompt_sha256: ([0-9a-f]{64})", fh.read(400))
+            existing_hash = m.group(1) if m else None
