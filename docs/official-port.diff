+def scoped(name: str):
+    """Decorator form of scope()."""
+    def deco(fn):
+        def wrapper(*args, **kwargs):
+            with scope(name):
+                return fn(*args, **kwargs)
+        wrapper.__name__ = getattr(fn, "__name__", "scoped")
+        return wrapper
+    return deco
